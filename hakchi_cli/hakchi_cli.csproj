<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>hakchi</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);HAKCHI_CLI</DefineConstants>
    <!-- Shared DesktopFile uses the harmless deprecated string.Copy API. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <PackageReference Include="LibUsbDotNet" Version="2.2.29" />
    <Compile Include="../Libraries/FelLib/FelLib/**/*.cs" Exclude="../Libraries/FelLib/FelLib/obj/**/*.cs;../Libraries/FelLib/FelLib/bin/**/*.cs" Link="Shared/FelLib/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Libraries/FelLib/FelHelpers/*.cs" Link="Shared/FelHelpers/%(Filename)%(Extension)" />
    <Compile Include="../hakchi_gui/ISystemShell.cs" Link="Shared/ISystemShell.cs" />
    <Compile Include="../hakchi_gui/Clovershell/*.cs" Link="Shared/Clovershell/%(Filename)%(Extension)" />
    <Compile Include="../hakchi_gui/Apps/DesktopFile.cs" Link="Shared/DesktopFile.cs" />
    <Compile Include="../hakchi_gui/Apps/INesMenuElement.cs" Link="Shared/INesMenuElement.cs" />
    <Compile Include="../hakchi_gui/Apps/CoreCommands.cs" Link="Shared/CoreCommands.cs" />
    <None Include="../hakchi_gui/data/fes1.bin" Link="payloads/fes1.bin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../hakchi_gui/images/blank_app.png" Link="payloads/blank_app.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <None Update="README.md;70-hakchi.rules" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
